# Service-repo checkouts, provisioned by /setup-workspace -- never committed here.
# INDEX.md (the generated workspace index) IS committed so it stays referenceable without cloning.
workspace/*
!workspace/.gitkeep
!workspace/INDEX.md

# Secrets
.env

# OS
.DS_Store
Thumbs.db

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Claude Code local settings + scratch
.claude/settings.local.json
.superpowers/

# Local reference checkouts, not part of the template
/repos/

# Obsidian per-user vault state — not shared
docs/architecture/**/.obsidian/
# Secrets. .env is no longer read by anything (see "Client resolution" in docs/process/README.md);
# it stays ignored so an old local copy is never committed.
# Per-machine resolved clients (see "Client resolution" in docs/process/README.md)
.claude/clients.local.json
# Implementation plans are local working notes, never committed
docs/superpowers/plans/
